        "models": {
          "openai/gpt-5.6-sol": {
            "agentRuntime": {
              "id": "codex"
            }
          }
        },
        "tools": {
          "deny": ["*"]
        }
      }
    ]
  },
  "tools": {
    "deny": ["*"],
    "elevated": {
      "enabled": false
    }
  },
  "channels": {}
